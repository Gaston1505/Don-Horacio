rules_version = '2';

// Don Horacio — reglas de Firestore (proyecto Firebase propio, separado de AEON).
// Publicar en: Firebase Console → Firestore Database → Reglas.
//
// Roles en usuarios/{uid}.rol:
//   admin     → todo, incluido dar de alta usuarios
//   encargado → todo menos usuarios
//   capataz   → registra (mover lotes, lluvias, novedades, comentarios, movimientos de hacienda,
//               puntos, aplicaciones en chacras, toros); no edita potreros, no borra y no ve plata
// Plata (ventas, precios de insumos y costos de chacras): solo admin y encargado.
// Una cuenta sin documento en usuarios no tiene acceso a nada.
//
// Ingreso con código (Eduardo, Martín): sesión anónima de Firebase + nombre + código del campo.
// Solo se acepta crear el propio perfil con rol "capataz" si el código existe en /codigos, una
// colección que solo el administrador puede leer (las funciones exists() de las reglas la ven
// igual, sin exponerla).
//
// Primer ingreso: la primera cuenta que entra queda como admin. Se permite crear
// usuarios/{uid} con rol admin solo mientras no exista config/instalacion, y en la misma
// escritura se crea config/instalacion — después de eso nadie más puede auto-asignarse admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function tienePerfil() { return request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function rol() { return perfil().data.rol; }
    function esAdmin() { return tienePerfil() && rol() == "admin"; }
    function puedeEditar() { return tienePerfil() && rol() in ["admin", "encargado"]; }
    function veDinero() { return puedeEditar(); }
    function puedeRegistrar() { return tienePerfil() && rol() in ["admin", "encargado", "capataz"]; }
    function instalado() { return exists(/databases/$(database)/documents/config/instalacion); }

    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if esAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.rol == "capataz" &&
        request.resource.data.codigo is string &&
        exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
      ) || (
        request.auth != null && request.auth.uid == uid && !instalado() &&
        request.resource.data.rol == "admin" &&
        getAfter(/databases/$(database)/documents/config/instalacion).data.adminUid == request.auth.uid
      );
      allow update, delete: if esAdmin() && uid != request.auth.uid;
    }

    match /codigos/{codigo} {
      allow read, write: if esAdmin();
    }

    match /config/instalacion {
      allow get: if request.auth != null;
      allow create: if request.auth != null && !instalado() &&
        request.resource.data.adminUid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    match /config/{docId} {
      allow read: if puedeRegistrar();
      allow write: if puedeEditar() || (docId == "general" && !instalado() && request.auth != null);
    }

    // Potreros: el capataz solo puede anotar el estado de los alambrados (ladosNotas).
    match /potreros/{id} {
      allow read: if puedeRegistrar();
      allow create, delete: if puedeEditar();
      allow update: if puedeEditar() || (puedeRegistrar() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ladosNotas", "actualizadoPor", "actualizadoEn"]));
    }

    // Lotes y ocupaciones: el capataz los mueve (crea/cierra ocupaciones y actualiza el lote).
    match /lotes/{id} {
      allow read: if puedeRegistrar();
      allow create, delete: if puedeEditar();
      allow update: if puedeRegistrar();
    }
    match /ocupaciones/{id} {
      allow read, create, update: if puedeRegistrar();
      allow delete: if puedeEditar();
    }

    // Registros del día a día: el capataz los crea, solo admin/encargado corrigen o borran.
    match /lluvias/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /eventos/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /movHacienda/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /puntos/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /comentarios/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /toros/{id} { allow read, create: if puedeRegistrar(); allow update, delete: if puedeEditar(); }
    match /servicios/{id} { allow read, create, update: if puedeRegistrar(); allow delete: if puedeEditar(); }

    // Chacras: el capataz puede anotar aplicaciones/siembras en un ciclo (update), pero crearlos,
    // cambiar la tabla de recomendaciones y borrar es del administrador/encargado.
    match /ciclos/{id} { allow read, update: if puedeRegistrar(); allow create, delete: if puedeEditar(); }
    match /insumos/{id} { allow read: if puedeRegistrar(); allow write: if puedeEditar(); }
    match /informes/{id} { allow read: if puedeRegistrar(); allow write: if puedeEditar(); }
    match /archivos/{id} { allow read: if puedeRegistrar(); allow write: if puedeEditar(); }
    match /archivosPartes/{id} { allow read: if puedeRegistrar(); allow write: if puedeEditar(); }

    // Plata
    match /costosCiclo/{id} { allow read, write: if veDinero(); }
    match /preciosInsumos/{id} { allow read, write: if veDinero(); }
    match /ventas/{id} { allow read, write: if veDinero(); }
    match /configDinero/{id} { allow read, write: if veDinero(); }
  }
}
